{
  "redirects": [
    {
      "source": "/AIkata.dc.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/About.dc.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/Contact.dc.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/GoogleProfile.dc.html",
      "destination": "/google-profile",
      "permanent": true
    },
    {
      "source": "/REO.dc.html",
      "destination": "/reo",
      "permanent": true
    },
    {
      "source": "/GreaseOzonizer.dc.html",
      "destination": "/grease-ozonizer",
      "permanent": true
    },
    {
      "source": "/lab/author/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/lib/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/kabeuchi",
      "destination": "/kabeuchi/",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacy/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/AIkata.dc.html"
    },
    {
      "source": "/about",
      "destination": "/About.dc.html"
    },
    {
      "source": "/contact",
      "destination": "/Contact.dc.html"
    },
    {
      "source": "/google-profile",
      "destination": "/GoogleProfile.dc.html"
    },
    {
      "source": "/reo",
      "destination": "/REO.dc.html"
    },
    {
      "source": "/grease-ozonizer",
      "destination": "/GreaseOzonizer.dc.html"
    }
  ],
  "functions": {
    "api/kabeuchi/chat.js": {
      "maxDuration": 60,
      "includeFiles": "lib/kabeuchi/**"
    },
    "api/kabeuchi/sweep.js": {
      "maxDuration": 60,
      "includeFiles": "lib/kabeuchi/**"
    }
  },
  "headers": [
    {
      "source": "/kabeuchi/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
        },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    },
    {
      "source": "/api/kabeuchi/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
